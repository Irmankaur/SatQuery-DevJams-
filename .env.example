# --- Gemini (existing) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Google Earth Engine (new) ---
# Requires a Google Cloud project with the Earth Engine API enabled:
# https://console.cloud.google.com/apis/library/earthengine.googleapis.com
# and that project registered at https://code.earthengine.google.com/register
EE_PROJECT=your-gcp-project-id

# Recommended: service account (works on servers, Vercel/Render/etc.)
# Create one at https://console.cloud.google.com/iam-admin/serviceaccounts,
# grant it the "Earth Engine Resource Viewer" role, download a JSON key.
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=./secrets/ee-service-account.json

# Alternative to the two lines above: point straight at the key file.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/ee-service-account.json

# Local-dev-only alternative (no service account): run this once, then
# leave EE_SERVICE_ACCOUNT / EE_PRIVATE_KEY_FILE unset and only set EE_PROJECT.
#   earthengine authenticate
